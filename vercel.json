{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "apps.api.index:app",
      "installCommand": "uv sync --locked --no-dev",
      "functions": {
        "apps/api/index.py": {
          "includeFiles": "{product-data/**,packages/downforce_core/src/**}",
          "excludeFiles": "{apps/web/**,Assets/**,assets/**,data/**,**/node_modules/**,**/tests/**,**/__tests__/**,**/test_*.py,**/*.test.py,**/graphify-out/**,.git/**,.github/**,.agents/**,.codex/**,.aws/**,.downforce/**,artifacts/**,docs/**,scripts/**,deployment/**,output/**,test-results/**,.playwright-cli/**,.venv/**,**/__pycache__/**,**/*.md}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": { "service": "backend" } },
    { "source": "/health", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
