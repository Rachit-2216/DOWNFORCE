# Browser-visible API origin used by the Next.js canonical API client.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Backend settings use the DOWNFORCE_ prefix. Lists are JSON encoded.
DOWNFORCE_ENVIRONMENT=development
DOWNFORCE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DOWNFORCE_LOG_LEVEL=INFO

# Vercel Services (Beta) production settings for the root vercel.json.
# Vercel defaults to the included read-only product-data bundle, without storage credentials.
# The client appends /api/v1; a same-origin frontend uses /, not /api.
# Production uses same-origin /api/v1 routes by default; no public API URL is required.
# NEXT_PUBLIC_API_URL=/
# DOWNFORCE_ENVIRONMENT=production
# DOWNFORCE_STORAGE_BACKEND=bundled
# NEXT_PUBLIC_DATA_PROFILE=visitor
# Optional alternative for an explicitly configured private-Blob deployment only:
# DOWNFORCE_STORAGE_BACKEND=vercel_blob
# DOWNFORCE_BLOB_ORIGIN=https://<store-id>.private.blob.vercel-storage.com
# DOWNFORCE_BLOB_RELEASE_PREFIX=releases/<immutable-release-sha256>
# DOWNFORCE_BLOB_RELEASE_SHA256=<release-json-sha256>
# DOWNFORCE_BLOB_TOKEN=<server-only-private-blob-credential>
# Cache defaults to a dedicated child of the platform temporary directory.
# DOWNFORCE_BLOB_CACHE_ROOT=/tmp/downforce-runtime-blob
# DOWNFORCE_BLOB_CACHE_MAX_BYTES=536870912
# DOWNFORCE_CORS_ORIGINS=["https://<frontend-host>"]
