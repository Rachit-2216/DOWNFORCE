# Browser-visible API origin used by the Next.js canonical API client.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Backend settings use the DOWNFORCE_ prefix. Lists are JSON encoded.
DOWNFORCE_ENVIRONMENT=development
DOWNFORCE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DOWNFORCE_LOG_LEVEL=INFO
